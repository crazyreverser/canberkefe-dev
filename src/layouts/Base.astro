---
import '../styles/global.css';
import Header from '../components/Header.astro';
import {
  SITE_TITLE,
  SITE_TITLE_SEO,
  SITE_DESCRIPTION,
  SITE_URL,
  CLOUDFLARE_ANALYTICS_TOKEN,
  AUTHOR,
  SOCIAL,
} from '../consts';

interface Props {
  lang?: 'en' | 'tr';
  title?: string;
  description?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  pageType?: 'WebPage' | 'ProfilePage' | 'CollectionPage';
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  lang = 'en',
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  ogImage = '/og-default.png',
  type = 'website',
  pubDate,
  updatedDate,
  tags = [],
  pageType = 'WebPage',
  noindex = false,
  structuredData = [],
} = Astro.props;

const fullTitle = title === SITE_TITLE ? SITE_TITLE_SEO : `${title} — ${SITE_TITLE}`;
const canonical = new URL(Astro.url.pathname, SITE_URL).toString();
const ogImageURL = new URL(ogImage, SITE_URL).toString();

const websiteSchema = {
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: SITE_TITLE,
  url: SITE_URL,
  description: SITE_DESCRIPTION,
  publisher: { '@id': `${SITE_URL}/#person` },
  inLanguage: ['en', 'tr'],
};

const personSchema = {
  '@type': 'Person',
  '@id': `${SITE_URL}/#person`,
  name: AUTHOR,
  url: `${SITE_URL}/about/`,
  sameAs: [SOCIAL.github, SOCIAL.twitter, SOCIAL.linkedin],
  knowsAbout: ['Vulnerability research', 'Reverse engineering', 'Firmware analysis', 'Web application development'],
};

const pageSchema = {
  '@type': pageType,
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: fullTitle,
  description,
  inLanguage: lang,
  isPartOf: { '@id': `${SITE_URL}/#website` },
  ...(pageType === 'ProfilePage' ? { mainEntity: { '@id': `${SITE_URL}/#person` } } : {}),
};

const articleSchema = type === 'article' && pubDate ? {
  '@type': 'BlogPosting',
  '@id': `${canonical}#article`,
  headline: title,
  description,
  url: canonical,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@id': `${SITE_URL}/#person` },
  publisher: { '@id': `${SITE_URL}/#person` },
  inLanguage: lang,
  keywords: tags.join(', '),
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  image: ogImageURL,
} : null;
const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [personSchema, websiteSchema, pageSchema, ...(articleSchema ? [articleSchema] : []), ...(Array.isArray(structuredData) ? structuredData : [structuredData])],
};
---
<!DOCTYPE html>
<html lang={lang} data-theme="favorite">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content={AUTHOR} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />

  <meta property="og:site_name" content={SITE_TITLE} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content={type} />
  <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:alt" content={title} />
  {pubDate    && <meta property="article:published_time" content={pubDate.toISOString()} />}
  {updatedDate && <meta property="article:modified_time"  content={updatedDate.toISOString()} />}
  {tags.map((t) => <meta property="article:tag" content={t} />)}
  <meta property="article:author" content={AUTHOR} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@canberkefe_" />
  <meta name="twitter:creator" content="@canberkefe_" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />
  <meta name="twitter:image:alt" content={title} />

  <script type="application/ld+json" set:html={JSON.stringify(schemaGraph).replace(/</g, '\\u003c')} />

  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('cb_theme');
        if (t) document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    })();
  </script>

  {CLOUDFLARE_ANALYTICS_TOKEN && (
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={`{"token": "${CLOUDFLARE_ANALYTICS_TOKEN}"}`}
    />
  )}
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <footer class="site-foot">
    <span>$ uptime · <a href="/about/" rel="author">Canberk Efe</a> · </span>
    <a href="/tags">tags</a> · <a href="/pgp.txt">pgp</a>
  </footer>
</body>
</html>
