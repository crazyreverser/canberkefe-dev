---
import Base from '../../layouts/Base.astro';
// Local previews can override the approved production assets and destinations.
const italianLogo = import.meta.env.DEV && import.meta.env.PUBLIC_ITALIAN_LOGO_URL
  ? import.meta.env.PUBLIC_ITALIAN_LOGO_URL
  : '/projects/lasatemikantare-elle.webp';

const projects = [
  {
    key: 'italian',
    name: 'Laşatemikantare',
    href: import.meta.env.DEV && import.meta.env.PUBLIC_ITALIAN_URL
      ? import.meta.env.PUBLIC_ITALIAN_URL
      : 'https://learnitalianwithme.canberkefe.dev/',
    description: 'Türkçe anlatımlı dersler, sesli örnekler ve alıştırmalarla sıfırdan İtalyanca A1’e.',
  },
  {
    key: 'hp',
    name: 'HP Quiz',
    href: import.meta.env.DEV && import.meta.env.PUBLIC_HPQUIZ_URL
      ? import.meta.env.PUBLIC_HPQUIZ_URL
      : 'https://hpquiz.canberkefe.dev/',
    description: 'Sekiz filmden 480 sahne sorusu ve Seçmen Şapka ile Hogwarts binanı keşfet.',
  },
];
const catalogueSchema = {
  '@type': 'ItemList',
  name: 'Canberk Efe’nin uygulamaları',
  itemListElement: projects.map((project, index) => ({
    '@type': 'ListItem', position: index + 1,
    item: {
      '@type': 'SoftwareApplication',
      name: project.name,
      url: project.key === 'hp' ? 'https://hpquiz.canberkefe.dev/' : 'https://learnitalianwithme.canberkefe.dev/',
      description: project.description,
      applicationCategory: project.key === 'hp' ? 'GameApplication' : 'EducationalApplication',
      operatingSystem: 'Web browser',
      creator: { '@id': 'https://canberkefe.dev/#person' },
    },
  })),
};
---
<Base lang="tr" title="aislop — Canberk Efe’nin Uygulamaları" description="Canberk Efe’nin uygulama kataloğu: 480 soruluk Harry Potter film quizi ve Seçmen Şapka; Laşatemikantare ile Türkçe anlatımlı İtalyanca A1." pageType="CollectionPage" structuredData={catalogueSchema}>
  <section class="logo-catalogue" aria-label="Uygulamalar">
    <h1 class="sr-only">Uygulamalar</h1>
    <div class="project-grid">
      {projects.map(project => (
        <a
          class={`project-card project-${project.key}`}
          href={project.href}
          aria-label={project.name}
          aria-describedby={`${project.key}-description`}
        >
          <div class="project-visual">
            <div class="project-front" aria-hidden="true">
              {project.key === 'italian' ? (
                <img class="italian-logo" src={italianLogo} width="112" height="112" alt="" />
              ) : (
                <img class="hp-logo" src="/projects/harry-potter-wordmark.png" width="600" height="219" alt="" decoding="async" />
              )}
            </div>
            <div class="project-back">
              <p id={`${project.key}-description`}>{project.description}</p>
            </div>
          </div>
          <h2 class="project-caption">{project.name}</h2>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .logo-catalogue {
    display: grid;
    place-items: center;
    flex: 1;
    width: 100%;
    padding: 48px 24px;
  }
  .project-grid {
    width: min(760px, 100%);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 260px));
    justify-content: center;
    align-items: center;
    gap: 120px;
  }
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    min-width: 0;
    height: 250px;
    color: var(--text);
    border-radius: 8px;
  }
  .project-visual { position: relative; width: 100%; height: 150px; }
  .project-caption { color: var(--muted); font-size: 13px; font-weight: 500; line-height: 1.5; margin: 0; text-align: center; }
  .project-front,
  .project-back {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 180ms ease, transform 260ms ease;
    pointer-events: none;
  }
  .italian-logo, .hp-logo { display: block; width: 112px; height: 112px; }
  .hp-logo {
    width: 180px;
    max-width: 100%;
    object-fit: contain;
  }
  .project-back {
    flex-direction: column;
    padding: 16px;
    text-align: center;
    opacity: 0;
    transform: translateY(8px);
  }
  .project-back p { color: var(--muted); font-size: 12px; line-height: 1.9; }
  .project-card:focus-visible { outline: 1px solid var(--border-2); outline-offset: 5px; }
  .project-card:focus-visible .project-front { opacity: 0; transform: translateY(-8px) scale(.96); }
  .project-card:focus-visible .project-back { opacity: 1; transform: none; }
  @media (hover: hover) {
    .project-card:hover .project-front { opacity: 0; transform: translateY(-8px) scale(.96); }
    .project-card:hover .project-back { opacity: 1; transform: none; }
  }
  @media (max-width: 680px) {
    .project-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
    .project-card { height: 220px; gap: 14px; }
    .italian-logo, .hp-logo { width: 92px; height: 92px; }
    .hp-logo { width: 148px; }
  }
  @media (max-width: 400px) {
    .logo-catalogue { padding: 32px 16px; }
    .project-grid { gap: 14px; }
    .italian-logo, .hp-logo { width: 80px; height: 80px; }
    .hp-logo { width: 130px; }
    .project-back { padding: 7px; }
    .project-caption { font-size: 11px; }
    .project-back p { font-size: 10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-front, .project-back { transition: none; }
  }
</style>
